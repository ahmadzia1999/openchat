<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Custom providers can be local HTTP servers (Ollama, LM Studio, LAN gateways). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
